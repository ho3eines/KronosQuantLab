# Non-secret settings only. This project needs NO API keys and must never be given any.
# These are read from the process environment (there is no .env loader).

# --- Market data: two public hosts, so a geographic block on one is survivable -----
# The public data host (read-only klines, no account access).
KQL_BINANCE_BASE_URL=https://data-api.binance.vision
# Used automatically when the primary host answers HTTP 451 (legal/geographic block)
# or 403. Comma-separated; the working host is remembered for the process lifetime.
KQL_BINANCE_FALLBACK_URLS=https://api.binance.com

# --- Candle interval: 1h, 4h or 1d -------------------------------------------------
# KQL_INTERVAL=1d

# --- Model window limits ------------------------------------------------------------
# KQL_LOOKBACK=400          # model context bars, at most 512
# KQL_MAX_HORIZON=96        # pred_len ceiling
# KQL_PRED_LEN=96           # default forecast horizon of `kql.py forecast`

# --- Model sampling defaults (override per command with flags) ----------------------
# KQL_SAMPLE_COUNT=20       # number of sampled paths
# KQL_TEMPERATURE=1.0
# KQL_TOP_P=0.9
# KQL_TOP_K=0

# --- Nobitex: public OHLC, no token ever ----------------------------------------
# KQL_NOBITEX_BASE_URL=https://apiv2.nobitex.ir
# KQL_NOBITEX_REQUEST_INTERVAL=1.0   # seconds between paged requests
# KQL_NOBITEX_TIMEOUT=30
# KQL_NOBITEX_RETRIES=3
# KQL_NOBITEX_HISTORY_START=2019-01-01  # floor used when no start is stored yet

# --- P3 threshold-calibration defaults ----------------------------------------------
# KQL_VALIDATION_ALPHA=0.05
# KQL_VALIDATION_NULL_ARI_MAX=          # empty/absent: calibrated from the permutations
# KQL_VALIDATION_STABILITY_THRESHOLD=   # empty/absent: calibrated to the null bound
# KQL_N_PERMUTATIONS=100
# KQL_N_BOOTSTRAP=50

# --- Qlib-style portfolio defaults --------------------------------------------------
# KQL_N_SYMBOL_HOLD=50
# KQL_N_SYMBOL_DROP=5
# KQL_HOLD_THRESH=5
# KQL_ACCOUNT=100000000

# --- Storage ------------------------------------------------------------------------
# Where weights, datasets and run outputs are stored (default: ./artifacts).
# KQL_ARTIFACTS_DIR=D:\kql_artifacts
# Location of the pinned upstream Kronos clone (default: ./vendor/Kronos).
# KQL_KRONOS_SRC=D:\src\Kronos
# SQLite file (default: <artifacts>/kql.sqlite3).
# KQL_DB_PATH=D:\kql_artifacts\kql.sqlite3
